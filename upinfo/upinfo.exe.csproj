<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>upinfo</AssemblyName>
    <PackageId>CoreCli.UpInfo</PackageId>
    <PackageDescription>Show system uptime and boot time from the command line.</PackageDescription>
    <PackageTags>dotnet-tool;uptime;cli</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>upinfo</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CoreCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
