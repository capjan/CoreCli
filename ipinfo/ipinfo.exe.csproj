<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ipinfo</AssemblyName>
    <PackageId>CoreCli.IpInfo</PackageId>
    <PackageDescription>Show public and local IP addresses from the command line.</PackageDescription>
    <PackageTags>dotnet-tool;ip;network;cli</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ipinfo</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CoreCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
